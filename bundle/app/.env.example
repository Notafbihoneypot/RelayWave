PORT=8787
# Public origin used by NIP-98. For local phone testing, set this to the exact LAN URL you open on Android.
PUBLIC_BASE_URL=http://192.168.1.50:8787
DEFAULT_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.nostr.band
DEFAULT_BLOSSOM=https://blossom.primal.net

# TEST ONLY. Enables a disposable server-side demo signer so the complete flow can be exercised
# without Amber/NIP-07. Never enable this on a public production deployment.
TEST_MODE=1
# Optional fixed demo secret. Leave blank to use the built-in disposable test secret.
DEMO_SECRET=

# Optional Podcast Index search. Keys are obtained from PodcastIndex.org.
PODCAST_INDEX_KEY=
PODCAST_INDEX_SECRET=

# Privacy analytics. Keep 0 unless the app is behind a trusted proxy that strips client-supplied
# forwarding/geo headers and sets its own X-Forwarded-For + country header.
ANALYTICS_TRUST_PROXY=0
# Country-level only; never city/region. Example when behind Cloudflare: cf-ipcountry
ANALYTICS_COUNTRY_HEADER=x-geo-country
# Minimum group size before a country/app/referrer category is shown. Code enforces >=5.
ANALYTICS_K=5
