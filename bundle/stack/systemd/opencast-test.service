[Unit]
Description=OpenCast local Proxmox test stack
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/opencast-test/scripts/start.sh
ExecStop=/opt/opencast-test/scripts/stop.sh
TimeoutStartSec=900
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
